From 6a5669b5c668f7522864b55880651507f87051d4 Mon Sep 17 00:00:00 2001
From: x1xhlol <lucknitelol@proton.me>
Date: Sat, 26 Sep 2026 21:25:04 +0000
Subject: [PATCH 5/7] wasm: Add SIMD128 DCT functions

sub4x4_dct, sub8x8_dct, sub16x16_dct, sub8x8_dct8, sub16x16_dct8 and
the matching add*_idct functions, 8-bit only.

Each 1D pass works lane-wise across the rows of the block and the
transposes are shuffles. The 4x4 transforms handle two blocks per
vector.
---
 Makefile                 |   3 +-
 common/dct.c             |   8 ++
 common/wasm/dct.c        | 277 +++++++++++++++++++++++++++++++++++++++
 common/wasm/dct.h        |  32 +++++
 common/wasm/wasmcommon.h |  23 ++++
 5 files changed, 342 insertions(+), 1 deletion(-)
 create mode 100644 common/wasm/dct.c
 create mode 100644 common/wasm/dct.h

diff --git a/Makefile b/Makefile
index fd64cf8f..1dcfbc4f 100644
--- a/Makefile
+++ b/Makefile
@@ -255,7 +255,8 @@ endif
 # WebAssembly SIMD128 optims
 ifeq ($(SYS_ARCH),WASM)
 ifneq ($(findstring HAVE_SIMD128 1, $(CONFIG)),)
-SRCS_X += common/wasm/mc.c \
+SRCS_X += common/wasm/dct.c \
+          common/wasm/mc.c \
           common/wasm/pixel.c
 endif
 endif
