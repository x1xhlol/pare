diff --git a/common/wasm/wasmcommon.h b/common/wasm/wasmcommon.h
index 016fdd04..6b415108 100644
--- a/common/wasm/wasmcommon.h
+++ b/common/wasm/wasmcommon.h
@@ -34,4 +34,27 @@ static ALWAYS_INLINE v128_t absdiff_u8x16( v128_t a, v128_t b )
     return wasm_i8x16_sub( wasm_u8x16_max( a, b ), wasm_u8x16_min( a, b ) );
 }
 
+/* Transposes an 8x8 matrix of 16-bit elements, one row per vector. */
+static ALWAYS_INLINE void transpose_8x8_i16( v128_t v[8] )
+{
+    v128_t a[8], b[8];
+    for( int i = 0; i < 8; i += 2 )
+    {
+        a[i]   = wasm_i16x8_shuffle( v[i], v[i+1], 0, 8, 1, 9, 2, 10, 3, 11 );
+        a[i+1] = wasm_i16x8_shuffle( v[i], v[i+1], 4, 12, 5, 13, 6, 14, 7, 15 );
+    }
+    for( int i = 0; i < 8; i += 4 )
+    {
+        b[i]   = wasm_i32x4_shuffle( a[i],   a[i+2], 0, 4, 1, 5 );
