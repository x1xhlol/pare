+#ifndef X264_WASM_WASMCOMMON_H
+#define X264_WASM_WASMCOMMON_H
+
+#include <wasm_simd128.h>
+
+/* |a - b| for unsigned bytes */
+static ALWAYS_INLINE v128_t absdiff_u8x16( v128_t a, v128_t b )
+{
+    return wasm_i8x16_sub( wasm_u8x16_max( a, b ), wasm_u8x16_min( a, b ) );
+}
+
+#endif
