 common/pixel.c           |   9 +
 common/wasm/pixel.c      | 641 +++++++++++++++++++++++++++++++++++++++
 common/wasm/pixel.h      |  32 ++
 common/wasm/wasmcommon.h |  37 +++
 5 files changed, 726 insertions(+)
 create mode 100644 common/wasm/pixel.c
 create mode 100644 common/wasm/pixel.h
 create mode 100644 common/wasm/wasmcommon.h

