From fd279d0e9b70973269241f70bb89845ee8e46160 Mon Sep 17 00:00:00 2001
From: x1xhlol <lucknitelol@proton.me>
Date: Sat, 26 Sep 2026 21:27:11 +0000
Subject: [PATCH 7/7] wasm: Add SIMD128 deblocking functions

The bS < 4 luma and chroma filters for both edge directions, 8-bit
only. Vertical edges are transposed into registers first: two luma
rows, or one chroma row, per 16-bit element.

deblock_h_chroma_420 is also used for deblock_chroma_422_mbaff, as on
the other architectures.
---
 Makefile              |   1 +
 common/deblock.c      |   8 ++
 common/wasm/deblock.c | 203 ++++++++++++++++++++++++++++++++++++++++++
 common/wasm/deblock.h |  32 +++++++
 4 files changed, 244 insertions(+)
 create mode 100644 common/wasm/deblock.c
 create mode 100644 common/wasm/deblock.h

diff --git a/Makefile b/Makefile
index 4c2fea89..b3d89154 100644
--- a/Makefile
+++ b/Makefile
@@ -256,6 +256,7 @@ endif
 ifeq ($(SYS_ARCH),WASM)
 ifneq ($(findstring HAVE_SIMD128 1, $(CONFIG)),)
 SRCS_X += common/wasm/dct.c \
+          common/wasm/deblock.c \
           common/wasm/mc.c \
           common/wasm/pixel.c \
           common/wasm/quant.c
diff --git a/common/deblock.c b/common/deblock.c
index acd94590..0d201dc3 100644
--- a/common/deblock.c
+++ b/common/deblock.c
@@ -683,6 +683,9 @@ void x264_macroblock_deblock( x264_t *h )
 #if HAVE_LSX
 #include "loongarch/deblock.h"
 #endif
+#if HAVE_SIMD128
+#include "wasm/deblock.h"
+#endif
 
 void x264_deblock_init( uint32_t cpu, x264_deblock_function_t *pf, int b_mbaff )
 {
@@ -843,6 +846,11 @@ void x264_deblock_init( uint32_t cpu, x264_deblock_function_t *pf, int b_mbaff )
     }
 #endif
 
+#if HAVE_SIMD128
+    if( cpu&X264_CPU_SIMD128 )
+        x264_deblock_init_simd128( pf );
+#endif
+
 #endif // !HIGH_BIT_DEPTH
 
     /* These functions are equivalent, so don't duplicate them. */
