From e6f174b1a0bf022989c3614088d42202dfcaf8bb Mon Sep 17 00:00:00 2001
From: x1xhlol <lucknitelol@proton.me>
Date: Sat, 26 Sep 2026 21:25:44 +0000
Subject: [PATCH 6/7] wasm: Add SIMD128 quant functions

quant_8x8, quant_4x4, quant_4x4x4 and quant_4x4_dc, 8-bit only.

The bias and multiplication are done in 32-bit lanes with the same
unsigned wraparound as QUANT_ONE, so the results match the C version
for all inputs, not only the ranges an encode produces.
---
 Makefile            |   3 +-
 common/quant.c      |   8 ++++
 common/wasm/quant.c | 101 ++++++++++++++++++++++++++++++++++++++++++++
 common/wasm/quant.h |  32 ++++++++++++++
 4 files changed, 143 insertions(+), 1 deletion(-)
 create mode 100644 common/wasm/quant.c
 create mode 100644 common/wasm/quant.h

diff --git a/Makefile b/Makefile
index 1dcfbc4f..4c2fea89 100644
--- a/Makefile
+++ b/Makefile
@@ -257,7 +257,8 @@ ifeq ($(SYS_ARCH),WASM)
 ifneq ($(findstring HAVE_SIMD128 1, $(CONFIG)),)
 SRCS_X += common/wasm/dct.c \
           common/wasm/mc.c \
-          common/wasm/pixel.c
+          common/wasm/pixel.c \
+          common/wasm/quant.c
 endif
 endif
 
diff --git a/common/quant.c b/common/quant.c
index 21bb2955..7903284d 100644
--- a/common/quant.c
+++ b/common/quant.c
@@ -46,6 +46,9 @@
 #if HAVE_LSX
 #   include "loongarch/quant.h"
 #endif
+#if HAVE_SIMD128
+#   include "wasm/quant.h"
+#endif
 
 #define QUANT_ONE( coef, mf, f ) \
 { \
@@ -874,6 +877,11 @@ void x264_quant_init( x264_t *h, uint32_t cpu, x264_quant_function_t *pf )
     }
 #endif
 
+#if HAVE_SIMD128
+    if( cpu&X264_CPU_SIMD128 )
+        x264_quant_init_simd128( pf );
+#endif
+
 #endif // HIGH_BIT_DEPTH
     pf->coeff_last[DCT_LUMA_DC]     = pf->coeff_last[DCT_CHROMAU_DC]  = pf->coeff_last[DCT_CHROMAV_DC] =
     pf->coeff_last[DCT_CHROMAU_4x4] = pf->coeff_last[DCT_CHROMAV_4x4] = pf->coeff_last[DCT_LUMA_4x4];
