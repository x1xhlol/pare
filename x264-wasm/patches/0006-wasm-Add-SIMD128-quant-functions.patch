+ * For more information, contact us at licensing@x264.com.
+ *****************************************************************************/
+
+#include "common/common.h"
+#include "wasmcommon.h"
+#include "quant.h"
+
+#if !HIGH_BIT_DEPTH
+/* Same as QUANT_ONE: the bias is added and the product taken in 32-bit lanes
+ * with unsigned wraparound, and coefficients <= 0 take the negated branch.
+ * Unlike the x86 and NEON versions, this matches the C for all inputs. */
+static ALWAYS_INLINE v128_t quant_8( v128_t coef, v128_t mf_lo, v128_t mf_hi, v128_t bias_lo, v128_t bias_hi )
+{
+    v128_t positive = wasm_i16x8_gt( coef, wasm_i16x8_splat( 0 ) );
+    /* abs(-32768) stays 0x8000, which is 32768 read as unsigned */
+    v128_t mag = wasm_i16x8_abs( coef );
+    v128_t lo = wasm_i32x4_mul( wasm_i32x4_add( wasm_u32x4_extend_low_u16x8( mag ), bias_lo ), mf_lo );
+    v128_t hi = wasm_i32x4_mul( wasm_i32x4_add( wasm_u32x4_extend_high_u16x8( mag ), bias_hi ), mf_hi );
+    lo = wasm_u32x4_shr( lo, 16 );
+    hi = wasm_u32x4_shr( hi, 16 );
+    /* keep the low 16 bits of each result, as storing to a dctcoef does */
+    v128_t v = wasm_i8x16_shuffle( lo, hi, 0, 1, 4, 5, 8, 9, 12, 13, 16, 17, 20, 21, 24, 25, 28, 29 );
+    return wasm_v128_bitselect( v, wasm_i16x8_neg( v ), positive );
+}
+
+/* Quantizes n coefficients in place and returns the OR of the results. */
+static ALWAYS_INLINE v128_t quant_n( dctcoef *dct, udctcoef *mf, udctcoef *bias, int n )
+{
+    v128_t nz = wasm_i16x8_splat( 0 );
+    for( int i = 0; i < n; i += 8 )
+    {
+        v128_t m = wasm_v128_load( mf + i ), b = wasm_v128_load( bias + i );
+        v128_t q = quant_8( wasm_v128_load( dct + i ),
+                            wasm_u32x4_extend_low_u16x8( m ), wasm_u32x4_extend_high_u16x8( m ),
+                            wasm_u32x4_extend_low_u16x8( b ), wasm_u32x4_extend_high_u16x8( b ) );
+        wasm_v128_store( dct + i, q );
+        nz = wasm_v128_or( nz, q );
+    }
+    return nz;
+}
+
+static int quant_8x8_simd128( dctcoef dct[64], udctcoef mf[64], udctcoef bias[64] )
+{
+    return wasm_v128_any_true( quant_n( dct, mf, bias, 64 ) );
+}
+
+static int quant_4x4_simd128( dctcoef dct[16], udctcoef mf[16], udctcoef bias[16] )
+{
+    return wasm_v128_any_true( quant_n( dct, mf, bias, 16 ) );
+}
+
+static int quant_4x4x4_simd128( dctcoef dct[4][16], udctcoef mf[16], udctcoef bias[16] )
+{
+    int nza = 0;
+    for( int j = 0; j < 4; j++ )
+        nza |= wasm_v128_any_true( quant_n( dct[j], mf, bias, 16 ) ) << j;
+    return nza;
+}
+
+static int quant_4x4_dc_simd128( dctcoef dct[16], int mf, int bias )
+{
+    v128_t vmf = wasm_i32x4_splat( mf ), vbias = wasm_i32x4_splat( bias );
+    v128_t a = quant_8( wasm_v128_load( dct ), vmf, vmf, vbias, vbias );
+    v128_t b = quant_8( wasm_v128_load( dct + 8 ), vmf, vmf, vbias, vbias );
+    wasm_v128_store( dct, a );
+    wasm_v128_store( dct + 8, b );
+    return wasm_v128_any_true( wasm_v128_or( a, b ) );
+}
+#endif // !HIGH_BIT_DEPTH
+
+void x264_quant_init_simd128( x264_quant_function_t *pf )
+{
+#if !HIGH_BIT_DEPTH
+    pf->quant_8x8    = quant_8x8_simd128;
+    pf->quant_4x4    = quant_4x4_simd128;
+    pf->quant_4x4x4  = quant_4x4x4_simd128;
+    pf->quant_4x4_dc = quant_4x4_dc_simd128;
+#endif // !HIGH_BIT_DEPTH
+}
