+/*****************************************************************************
+ * quant-simd128.c: WebAssembly SIMD128 quantization (8-bit only)
+ *****************************************************************************
+ * Included from common/quant.c. Matches QUANT_ONE exactly: the bias add and
+ * multiply are done in 32-bit lanes with uint32 wraparound, and coefficients
+ * <= 0 take the negated branch, just like the C.
+ *****************************************************************************/
+
+#include <wasm_simd128.h>
+
+#define ALWAYS_INLINE static inline __attribute__((always_inline))
+
+/* mf and bias arrive as 32-bit lanes: low/high halves for the 8 coefficients. */
+ALWAYS_INLINE v128_t quant_8coefs32( v128_t coef, v128_t mf_lo, v128_t mf_hi, v128_t bias_lo, v128_t bias_hi )
+{
+    v128_t positive = wasm_i16x8_gt( coef, wasm_i16x8_splat( 0 ) );
+    v128_t mag = wasm_i16x8_abs( coef ); /* -32768 stays 0x8000, i.e. 32768 unsigned */
+    v128_t lo = wasm_i32x4_mul( wasm_i32x4_add( wasm_u32x4_extend_low_u16x8( mag ), bias_lo ), mf_lo );
+    v128_t hi = wasm_i32x4_mul( wasm_i32x4_add( wasm_u32x4_extend_high_u16x8( mag ), bias_hi ), mf_hi );
+    lo = wasm_u32x4_shr( lo, 16 );
+    hi = wasm_u32x4_shr( hi, 16 );
+    /* Keep the low 16 bits of each 32-bit result, as the C does when storing into a dctcoef. */
+    v128_t v = wasm_i8x16_shuffle( lo, hi, 0, 1, 4, 5, 8, 9, 12, 13, 16, 17, 20, 21, 24, 25, 28, 29 );
+    return wasm_v128_bitselect( v, wasm_i16x8_neg( v ), positive );
+}
+
+ALWAYS_INLINE v128_t quant_8coefs( v128_t coef, v128_t mf, v128_t bias )
+{
+    return quant_8coefs32( coef, wasm_u32x4_extend_low_u16x8( mf ), wasm_u32x4_extend_high_u16x8( mf ),
+                           wasm_u32x4_extend_low_u16x8( bias ), wasm_u32x4_extend_high_u16x8( bias ) );
+}
+
+/* Quantizes n coefficients in place and returns the OR of the results. */
+ALWAYS_INLINE v128_t quant_block( dctcoef *dct, const udctcoef *mf, const udctcoef *bias, int n )
+{
+    v128_t nz = wasm_i16x8_splat( 0 );
+    for( int i = 0; i < n; i += 8 )
+    {
+        v128_t q = quant_8coefs( wasm_v128_load( dct + i ), wasm_v128_load( mf + i ), wasm_v128_load( bias + i ) );
+        wasm_v128_store( dct + i, q );
+        nz = wasm_v128_or( nz, q );
+    }
+    return nz;
+}
+
+static int quant_8x8_simd128( dctcoef dct[64], udctcoef mf[64], udctcoef bias[64] )
+{
+    return wasm_v128_any_true( quant_block( dct, mf, bias, 64 ) );
+}
+
+static int quant_4x4_simd128( dctcoef dct[16], udctcoef mf[16], udctcoef bias[16] )
+{
+    return wasm_v128_any_true( quant_block( dct, mf, bias, 16 ) );
+}
+
+static int quant_4x4x4_simd128( dctcoef dct[4][16], udctcoef mf[16], udctcoef bias[16] )
+{
+    int nza = 0;
+    for( int j = 0; j < 4; j++ )
+        nza |= wasm_v128_any_true( quant_block( dct[j], mf, bias, 16 ) ) << j;
+    return nza;
+}
+
+static int quant_4x4_dc_simd128( dctcoef dct[16], int mf, int bias )
+{
+    v128_t vmf = wasm_i32x4_splat( mf ), vbias = wasm_i32x4_splat( bias );
+    v128_t a = quant_8coefs32( wasm_v128_load( dct ), vmf, vmf, vbias, vbias );
+    v128_t b = quant_8coefs32( wasm_v128_load( dct + 8 ), vmf, vmf, vbias, vbias );
+    wasm_v128_store( dct, a );
+    wasm_v128_store( dct + 8, b );
+    return wasm_v128_any_true( wasm_v128_or( a, b ) );
+}
+
+static void x264_quant_init_simd128( x264_quant_function_t *pf )
+{
+    pf->quant_8x8    = quant_8x8_simd128;
+    pf->quant_4x4    = quant_4x4_simd128;
+    pf->quant_4x4x4  = quant_4x4x4_simd128;
+    pf->quant_4x4_dc = quant_4x4_dc_simd128;
+}
