{
  "name": "Pare",
  "short_name": "Pare",
  "description": "Compress video on your device. Nothing is uploaded.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f9f8f5",
  "theme_color": "#f9f8f5",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "video",
          "accept": [
            "video/*",
            ".mp4",
            ".m4v",
            ".mov",
            ".webm",
            ".mkv"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "video/mp4": [
          ".mp4",
          ".m4v"
        ],
        "video/quicktime": [
          ".mov"
        ],
        "video/webm": [
          ".webm"
        ],
        "video/x-matroska": [
          ".mkv"
        ]
      }
    }
  ]
}
